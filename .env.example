# Venezuela Energy Monitor - Environment Variables
# Copy this file to .env.local and fill in your API keys

# ======================
# AI & Analysis
# ======================
GROQ_API_KEY=gsk_your_groq_api_key_here
# Get key from: https://console.groq.com

# ======================
# Caching & Database
# ======================
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_token_here
# Get from: https://console.upstash.com

# ======================
# Energy Data APIs
# ======================
EIA_API_KEY=your_eia_api_key_here
# U.S. Energy Information Administration
# Get from: https://www.eia.gov/opendata/

PLATTS_API_KEY=your_platts_key_here
# S&P Global Platts (optional, paid service)

# ======================
# Maritime Tracking
# ======================
MARINETRAFFIC_API_KEY=your_marinetraffic_key_here
# For tanker tracking
# Get from: https://www.marinetraffic.com/en/ais-api-services

VESSELFINDER_API_KEY=your_vesselfinder_key_here
# Alternative AIS tracking
# Get from: https://www.vesselfinder.com/api

# ======================
# Satellite & Environmental
# ======================
NASA_FIRMS_API_KEY=your_nasa_firms_key_here
# Fire/flaring detection
# Get from: https://firms.modaps.eosdis.nasa.gov/api/

SENTINEL_HUB_CLIENT_ID=your_sentinel_client_id
SENTINEL_HUB_CLIENT_SECRET=your_sentinel_secret
# Satellite imagery for oil spills, infrastructure
# Get from: https://www.sentinel-hub.com/

# ======================
# News Aggregation
# ======================
NEWSAPI_KEY=your_newsapi_key_here
# For supplementary news sources
# Get from: https://newsapi.org/

# ======================
# Additional Data
# ======================
OPENSKY_USERNAME=your_opensky_username
OPENSKY_PASSWORD=your_opensky_password
# For helicopter traffic to offshore platforms
# Free account: https://opensky-network.org/

# ======================
# Optional Services
# ======================
CLOUDFLARE_RADAR_TOKEN=your_cloudflare_token
# Internet outage detection during blackouts
